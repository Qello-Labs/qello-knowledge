# Qello Knowledge 설정 예시. 이 파일은 qello_knowledge.config.example이 만든다. 직접 고치지 않는다.
# 복사해서 .env로 쓰고 값을 채운다. .env는 git에 올리지 않는다.
# 같은 이름의 실행 환경 변수가 있으면 그 값이 우선한다.

# PostgreSQL 연결 문자열. 로컬 개발은 compose.yaml의 DB를 가리킨다
# 진입점: 질의응답, 색인 | 필수, 비밀 | 형식: `postgres` 또는 `postgresql` 스킴의 URL
DATABASE_URL=<database-url>

# GitHub 저장소 읽기 전용 토큰
# 진입점: 색인 | 필수, 비밀 | 형식: `ghp_` 또는 `github_pat_`로 시작
GITHUB_API_TOKEN=<github-api-token>

# 색인·질의 서비스가 Workers AI REST를 부를 때 쓰는 전용 토큰
# 진입점: 질의응답, 색인 | 필수, 비밀 | 형식: 공백 없는 40자 이상
CLOUDFLARE_API_TOKEN=<cloudflare-api-token>

# Workers AI REST 호출에 쓰는 Cloudflare 계정 ID
# 진입점: 질의응답, 색인 | 필수 | 형식: 32자리 16진수
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>

# Discord 애플리케이션 ID
# 진입점: 질의응답, 명령 등록 | 필수 | 형식: 숫자 17~20자리
DISCORD_APPLICATION_ID=<discord-application-id>

# Discord 상호작용 요청 서명 검증용 공개 키
# 진입점: 질의응답, 중계 Worker | 필수 | 형식: 64자리 16진수
DISCORD_PUBLIC_KEY=<discord-public-key>

# 명령 등록 전용 Discord 봇 토큰. 질의 경로에는 두지 않는다
# 진입점: 명령 등록 | 필수, 비밀 | 형식: 공백 없는 50자 이상
DISCORD_BOT_TOKEN=<discord-bot-token>

# 명령을 쓰는 Discord 서버 ID
# 진입점: 질의응답, 명령 등록 | 필수 | 형식: 숫자 17~20자리
QK_DISCORD_GUILD_ID=<qk-discord-guild-id>

# 중계 제한 시간(초)
# 진입점: 중계 Worker | 선택 | 형식: 0.5 이상 2.8 이하 초
QK_RELAY_TIMEOUT_SECONDS=2.5

# 허용 채널 목록. 비면 모든 요청을 거부한다
# 진입점: 질의응답 | 선택 | 형식: 쉼표로 나눈 중복·공백 없는 숫자 17~20자리 목록(빈 값 허용)
QK_DISCORD_ALLOWED_CHANNELS=

# 허용 역할 목록. 비면 역할 제한 없음
# 진입점: 질의응답 | 선택 | 형식: 쉼표로 나눈 중복·공백 없는 숫자 17~20자리 목록(빈 값 허용)
QK_DISCORD_ALLOWED_ROLES=

# 질의 마감(초)
# 진입점: 질의응답 | 선택 | 형식: 15 이상 120 이하 정수
QK_QUERY_DEADLINE_SECONDS=55

# 시작 확인 대기(초)
# 진입점: 질의응답 | 선택 | 형식: 4 이상 10 이하 정수
QK_QUERY_START_WAIT_SECONDS=5

# 실행에 필요한 최소 남은 시간(초)
# 진입점: 질의응답 | 선택 | 형식: 8 이상 60 이하 정수
QK_QUERY_MIN_START_SECONDS=15

# 안내 전달 여유(초)
# 진입점: 질의응답 | 선택 | 형식: 1 이상 30 이하 정수
QK_QUERY_NOTICE_GRACE_SECONDS=5

# 질의 외부 호출 상한
# 진입점: 질의응답 | 선택 | 형식: 11 이상 50 이하 정수
QK_QUERY_CALL_LIMIT=20

# 답변 메시지 수 상한
# 진입점: 질의응답 | 선택 | 형식: 2 이상 10 이하 정수
QK_DISCORD_MAX_MESSAGES=4

# 출처 제목 길이 상한
# 진입점: 질의응답 | 선택 | 형식: 20 이상 200 이하 정수
QK_DISCORD_TITLE_MAX_CHARS=80

# 출처 링크 길이 상한
# 진입점: 질의응답 | 선택 | 형식: 50 이상 1000 이하 정수
QK_DISCORD_LINK_MAX_CHARS=300

# 동시 검색·생성 실행 자리
# 진입점: 질의응답 | 선택 | 형식: 1 이상 8 이하 정수
QK_QUERY_WORKERS=2

# 수명 자리의 추가 대기 크기
# 진입점: 질의응답 | 선택 | 형식: 1 이상 16 이하 정수
QK_QUERY_QUEUE_SIZE=4

# 로그 수준
# 진입점: 질의응답, 색인 | 선택 | 형식: `DEBUG`, `INFO`, `WARNING`, `ERROR` 중 하나
QK_LOG_LEVEL=INFO

# Workers AI 하루 무료 할당(Neurons). 하루 경계는 00:00 UTC다
# 진입점: 질의응답, 색인 | 선택 | 형식: 양의 정수
QK_EMBED_DAILY_ALLOWANCE=10000

# 색인 임베딩이 하루에 쓸 수 있는 Neurons. 색인 예산 + 질의응답 예비분은 하루 할당 이하여야 한다
# 진입점: 질의응답, 색인 | 선택 | 형식: 양의 정수
QK_EMBED_INDEX_BUDGET=5000

# 질의응답 몫으로 남겨 두는 하루 Neurons. 넘으면 경고만 하고 질의는 막지 않는다
# 진입점: 질의응답, 색인 | 선택 | 형식: 양의 정수
QK_EMBED_QUERY_RESERVE=3000

# 검색이 생성에 넘기는 Context의 예상 토큰 예산(QK-RET-001). 프롬프트·출력 몫은 들어 있지 않다
# 진입점: 질의응답, 색인 | 선택 | 형식: 1 이상 8000 이하 정수
QK_RETRIEVAL_CONTEXT_BUDGET=2000

# 답변 생성 모델(QK-GEN-001, ADR-009). qwen3 계열만 받는다. 다른 계열은 ADR-009 개정이 필요하다
# 진입점: 질의응답, 색인 | 선택 | 형식: `@cf/qwen/qwen3-`로 시작하는 Workers AI 모델 식별자
QK_GEN_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# 답변 생성 출력 상한(토큰)
# 진입점: 질의응답, 색인 | 선택 | 형식: 1 이상 4096 이하 정수
QK_GEN_MAX_TOKENS=800

# 답변 생성 온도
# 진입점: 질의응답, 색인 | 선택 | 형식: 0 이상 1 이하 소수(소수점 아래 3자리까지)
QK_GEN_TEMPERATURE=0.2

# 생성 호출 한 번의 시간 제한(초). 재시도 마감은 이 값의 두 배 + 5초다
# 진입점: 질의응답, 색인 | 선택 | 형식: 1 이상 60 이하 정수(초)
QK_GEN_TIMEOUT_SECONDS=20

# 답변 생성 프롬프트. 기본은 승인된 후보 1, 비교용은 기준 프롬프트다
# 진입점: 질의응답, 색인 | 선택 | 형식: `gen-p1` 또는 `gen-base`
QK_GEN_PROMPT_VERSION=gen-p1
